{
	"name": "odontogram-periodontogram-core",
	"description": "Odontogram (NTS/MINSA Peru) and periodontogram React components with anatomical SVG teeth.",
	"version": "0.2.2",
	"author": "Manuel Díaz Calua",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kmanuelDC/odontogram_periodontogram.git"
	},
	"homepage": "https://github.com/kmanuelDC/odontogram_periodontogram#readme",
	"bugs": {
		"url": "https://github.com/kmanuelDC/odontogram_periodontogram/issues"
	},
	"keywords": [
		"odontogram",
		"periodontogram",
		"periodontal-chart",
		"dental-chart",
		"dental",
		"react",
		"fdi"
	],
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"scripts": {
		"build": "tsup",
		"prepublishOnly": "pnpm lint:ci && pnpm typecheck && pnpm test:ci && pnpm build",
		"lint": "biome check --write --unsafe .",
		"lint:ci": "biome check --unsafe .",
		"typecheck": "tsc",
		"test": "vitest",
		"test:ci": "vitest run --coverage",
		"storybook": "storybook dev -p 6007",
		"storybook:build": "storybook build"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./rules": {
			"import": {
				"types": "./dist/rules.d.ts",
				"default": "./dist/rules.js"
			},
			"require": {
				"types": "./dist/rules.d.cts",
				"default": "./dist/rules.cjs"
			}
		},
		"./style.css": "./dist/index.css",
		"./print.css": "./dist/print.css",
		"./package.json": "./package.json"
	},
	"sideEffects": ["*.css"],
	"files": ["dist", "LICENSE", "README.md", "CHANGELOG.md"],
	"engines": {
		"node": ">=18.0.0"
	},
	"peerDependencies": {
		"react": ">=17",
		"react-dom": ">=17"
	},
	"peerDependenciesMeta": {
		"react": { "optional": true },
		"react-dom": { "optional": true }
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@storybook/addon-a11y": "10.2.10",
		"@storybook/addon-docs": "10.2.10",
		"@storybook/addon-themes": "10.2.10",
		"@storybook/addon-webpack5-compiler-swc": "4.0.2",
		"@storybook/react-webpack5": "10.2.10",
		"@testing-library/jest-dom": "6.6.3",
		"@testing-library/react": "16.2.0",
		"@types/node": "22.13.11",
		"@types/react": "18.3.13",
		"@types/react-dom": "18.3.1",
		"@vitest/coverage-v8": "3.0.9",
		"axe-core": "4.11.0",
		"jsdom": "26.0.0",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"storybook": "10.2.10",
		"tsup": "8.4.0",
		"typescript": "5.8.2",
		"vitest": "3.0.9"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["@biomejs/biome", "@swc/core", "esbuild"]
	}
}
